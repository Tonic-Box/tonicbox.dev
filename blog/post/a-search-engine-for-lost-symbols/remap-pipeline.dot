// The pipeline: extract -> vectorize -> score -> promote, looping back to recompute
// over the grown corpus until nothing new promotes; the old mappings enter ONLY at the
// final translate step.
digraph pipeline {
  bgcolor="transparent";
  rankdir=LR; nodesep=0.4; ranksep=0.55;
  node [shape=box, style="rounded,filled", fontname="monospace", fontsize=10,
        fillcolor="#0d111a", color="#2a3554", fontcolor="#c0caf5", penwidth=1.3, margin="0.15,0.09"];
  edge [color="#3a4266", penwidth=1.1, arrowsize=0.7, fontname="monospace", fontsize=9, fontcolor="#565f89"];

  extract   [label="extract\ncontext", color="#7aa2f7"];
  vectorize [label="vectorize\nTF-IDF", color="#7aa2f7"];
  score     [label="score\nsimilarity", color="#7aa2f7"];
  promote   [label="promote\nresolved", color="#7aa2f7"];
  translate [label="translate", color="#9ece6a", fillcolor="#10231a"];
  oldmap    [label="old mappings", shape=note, color="#bb9af7", fontcolor="#bb9af7"];
  newmap    [label="new mappings", shape=note, color="#9ece6a", fontcolor="#9ece6a", fillcolor="#10231a"];

  extract -> vectorize -> score -> promote;
  promote -> translate [label="stable", fontcolor="#9ece6a"];
  promote -> vectorize [label="grow vocab,\nrecompute", color="#e0af68", fontcolor="#e0af68", constraint=false];
  oldmap -> translate [style=dashed, color="#bb9af7", label="only here", fontcolor="#bb9af7"];
  translate -> newmap [color="#9ece6a"];
}
